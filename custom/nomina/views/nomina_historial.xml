<odoo>

    <!-- SEARCH VIEW -->
    <record id="nomina_historial_form_view" model="ir.ui.view">
        <field name="name">nomina.historial.form.view</field>
        <field name="model">nomina.historial</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" class="h1 text-muted"/>
                            <field name="empleado_id"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="nomina_historial_list_view" model="ir.ui.view">
        <field name="name">nomina.historial.list.view</field>
        <field name="model">nomina.historial</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" class="fw-bold"/>
                <field name="empleado_id"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="nomina_historial_search_view" model="ir.ui.view">
        <field name="name">nomina.historial.search.view</field>
        <field name="model">nomina.historial</field>
        <field name="arch" type="xml">
            <search>
                <filter
                    string="Archivados"
                    name="archived"
                    domain="[('active','!=',True)]"
                />
            </search>
        </field>
    </record>

    <!-- ACCIÓN -->
    <record id="nomina_historial_action" model="ir.actions.act_window">
        <field name="name">Nómina Historial</field>
        <field name="res_model">nomina.historial</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="nomina_historial_search_view"/>
    </record>

</odoo>