<!-- Fichero Claude -->
<odoo>

    <!-- VISTA FORMULARIO: agrega campos de nómina al formulario nativo de asistencias -->
    <record id="hr_attendance_view_form_nomina" model="ir.ui.view">
        <field name="name">hr.attendance.form.nomina</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[1]" position="after">
                <group string="Nómina" class="bg-light px-2 pb-2">
                    <field name="horas_programadas" widget="float_time"/>
                    <field name="tiempo_descanso" widget="float_time"/>
                    <field name="tipo_dia"/>
                    <field name="retardo_minutos"/>
                    <field name="es_retardo" widget="boolean_toggle"/>
                    <field name="auto_checkout" widget="boolean_toggle"/>
                    <field name="origen_incidencia_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
