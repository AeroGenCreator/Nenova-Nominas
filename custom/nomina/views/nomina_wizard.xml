<odoo>

    <!-- VISTA FORMULARIO -->
    <record id="nomina_wizard_form_view" model="ir.ui.view">
        <field name="name">nomina.wizard.form.view</field>
        <field name="model">nomina.wizard</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" class="h1 text-info py-1"/>
                        <group string="Datos Empleado">
                            <field name="empleado_id" class="py-1"/>
                            <field name="sueldo"/>
                            <field name="periodicidad"/>
                            <field name="sueldo_diario" widget="custom_monetary_float"/>
                            <field name="sdi" widget="custom_monetary_float"/>
                            <field name="percepciones_total"/>
                        </group>
                        <group string="Cálculo Factores">
                            <field name="fecha_emision" readonly="1" class="text-warning"/>
                            <field name="uma_id"/>
                            <field name="factor_riesgo_trabajo_id" class="text-danger"/>
                            <field name="total_dias"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Percepciones">
                            <field name="percepciones_ids"/>
                        </page>
                        <page string="Deducciones">
                            
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button
                        string="Guardar / Validar Nomina"
                        name=""
                        class="btn-success"
                        type="object"
                    />
                    <!-- Botón rojo para cancelar -->
                    <button
                        string="Cerrar Ventana"
                        class="btn-danger"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <!-- ACCIÓN -->
    <record id="nomina_wizard_action" model="ir.actions.act_window">
        <field name="name">Nómina</field>
        <field name="res_model">nomina.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>