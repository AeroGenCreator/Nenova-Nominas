<odoo>

    <!-- VISTA FORMULARIO -->
    <record id="nomina_wizard_form_view" model="ir.ui.view">
        <field name="name">nomina.wizard.form.view</field>
        <field name="model">nomina.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="container h1 text-primary">
                    <div class="row">
                        <div class="col">
                            <field name="name" class="py-2 text-center"/>
                        </div>
                    </div>
                </div>
                <sheet>
                    <p class="text-info">Definir el periodo (fecha inicio - fecha fin) para determinar numero de dias considerdados para esta nomina. (Ambos rangos son incluyentes).</p>
                    <group>
                        <group string="Datos Empleado">
                            <field name="empleado_id" class="py-1"/>
                            <field name="periodicidad"/>
                            <field name="sueldo" widget="custom_monetary_float"/>
                            <field name="sueldo_diario" widget="custom_monetary_float"/>
                            <field name="factor_integracion" widget="char"/>
                            <field name="sdi" widget="custom_monetary_float" class="text-info"/>
                        </group>
                        <group string="Configuración">
                            <field name="fecha_emision" readonly="1" class="text-primary"/>
                            <field name="fecha_inicio" class="text-success"/>
                            <field name="fecha_fin" class="text-success"/>
                            <field name="rango_seleccionado"/>
                            <field name="modo_asistencia" widget="statusbar" options="{'clickable': 1}"/>
                        </group>
                    </group>
                    <p class="alert alert-info" role="alert" invisible="modo_asistencia != 'automatico'">
                        Modo Automático: al guardar se generarán deducciones de falta/retardo y la percepción de horas extra
                        a partir de las asistencias e incidencias ya registradas del empleado en este rango de fechas.
                    </p>
                    <p class="text-warning">El sueldo debe ser agregado como una percepcion (fila) en la siguiente tabla.</p>
                    <notebook>
                        <page string="Percepciones" class="fw-bold">
                            <field name="percepcion_ids">
                                <list>
                                    <field name="concepto_id" class="text-success" width="80"/>
                                    <field name="cantidad" width="80"/>
                                    <field name="importe" widget="custom_monetary_float" width="80"/>
                                    <field name="total" widget="custom_monetary_float" width="80"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <footer>
                    <button
                        string="Guardar - Validar Nómina"
                        name="action_construir_nomina"
                        class="btn-success"
                        type="object"
                    />
                    <!-- Botón rojo para cancelar -->
                    <button
                        string="Cerrar Ventana"
                        class="btn-danger"
                        special="cancel"
                    />
                </footer>
            </form>
        </field>
    </record>

    <!-- ACCIÓN -->
    <record id="nomina_wizard_action" model="ir.actions.act_window">
        <field name="name">Nómina</field>
        <field name="res_model">nomina.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>