<odoo>
    
    <!-- VISTA FORMULARIO -->
    <record id="uma_form_view" model="ir.ui.view">
        <field name="name">uma.form.view</field>
        <field name="model">nomina.uma</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" class="fw-bold"/>
                            <field name="uma" widget="custom_monetary_float"/>
                        </group>
                        <group>
                            <field name="fecha_activacion"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- VISTA LISTA -->
    <record id="uma_list_view" model="ir.ui.view">
        <field name="name">uma.list.view</field>
        <field name="model">nomina.uma</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" width="60"/>
                <field name="uma" width="60" widget="custom_monetary_float"/>
                <field name="fecha_activacion" width="60"/>
                <field name="active" width="60"/>
            </list>
        </field>
    </record>

    <!-- VISTA SEARCH -->
    <record id="uma_search_view" model="ir.ui.view">
        <field name="name">uma.search.view</field>
        <field name="model">nomina.uma</field>
        <field name="arch" type="xml">
            <search>
                <filter
                    string="Archivados"
                    name="archived"
                    domain="[('active','!=',True)]"
                />
            </search>
        </field>
    </record>

    <!-- ACCION -->
    <record id="uma_action" model="ir.actions.act_window">
        <field name="name">UMAs</field>
        <field name="res_model">nomina.uma</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>