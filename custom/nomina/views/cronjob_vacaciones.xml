<odoo>
    <data noupdate="1">
        <record id="ir_cron_action_refrescar_derecho_vacacional" model="ir.cron">
            <field name="name">Ejecución Diaria de action_refrescar_derecho_vacacional</field>
            <field name="model_id" ref="model_nomina_main_view"/>
            <field name="state">code</field>
            <field name="code">model.action_refrescar_derecho_vacacional()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- Corregido: Usando el objeto 'time' nativo del evaluador de Odoo -->
            <field name="nextcall" eval="(time.strftime('%Y-%m-%d 00:00:00'))"/>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>