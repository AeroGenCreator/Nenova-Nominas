<odoo>

    <!-- FORM VIEW -->
    <record id="nomina_form_view" model="ir.ui.view">
        <field name="name">nomina.form.view</field>
        <field name="model">nomina.nomina</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_calcular_isr" string="Calcular ISR" type="object" class="btn-primary"/>
                    <button name="action_calcular_imss" string="Calcular IMSS" type="object" class="btn-primary"/>
                    <field name="estado" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" class="h1 text-muted" readonly="1"/>
                            <field name="fecha_emision" class="text-primary"/>
                            <field name="empleado_id" readonly="1"/>
                            <field name="fecha_inicio" readonly="1"/>
                            <field name="fecha_fin" readonly="1"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="total_percepciones" widget="custom_monetary_float"/>
                            <field name="total_deducciones" widget="custom_monetary_float"/>
                            <field name="neto" widget="custom_monetary_float"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Percepciones">
                            <field name="percepcion_ids">
                                <list>
                                    <field name="concepto_id" width="80"/>
                                    <field name="cantidad" width="80"/>
                                    <field 
                                        name="importe"
                                        widget="custom_monetary_float"
                                        width="80"
                                    />
                                    <field
                                        name="importe_gravado"
                                        widget="custom_monetary_float"
                                        width="80"
                                    />
                                    <field
                                        name="importe_exento"
                                        widget="custom_monetary_float"
                                        width="80"
                                    />
                                    <field
                                        name="total"
                                        widget="custom_monetary_float"
                                        width="80"
                                    />
                                </list>
                            </field>
                        </page>
                        <page string="Deducciones">
                            <field name="deduccion_ids">
                                <list>
                                    <field name="tipo"/>
                                    <field name="concepto"/>
                                    <field name="importe"/>
                                </list>
                            </field>
                        </page>
                        <page string="Días">
                            <group string="Asistencias">
                                <field name="attendance_ids" nolabel="1">
                                    <list create="false" delete="false">
                                        <field name="check_in"/>
                                        <field name="check_out"/>
                                        <field name="horas_programadas" widget="float_time"/>
                                        <field name="worked_hours" widget="float_time"/>
                                        <field name="tipo_dia"/>
                                        <field name="es_retardo"/>
                                        <field name="retardo_minutos"/>
                                        <field name="auto_checkout"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Incidencias">
                                <field name="incidencia_ids" nolabel="1">
                                    <list create="false" delete="false">
                                        <field name="fecha"/>
                                        <field name="tipo"/>
                                        <field name="dias"/>
                                        <field name="justificacion"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Horas Extra">
                                <field name="hora_extra_ids" nolabel="1">
                                    <list create="false" delete="false">
                                        <field name="fecha"/>
                                        <field name="hora_inicio"/>
                                        <field name="hora_fin"/>
                                        <field name="horas" widget="float_time"/>
                                        <field name="estado"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="nomina_list_view" model="ir.ui.view">
        <field name="name">nomina.list.view</field>
        <field name="model">nomina.nomina</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="empleado_id"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                <field name="estado"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="total_percepciones" widget="custom_monetary_float"/>
                <field name="total_deducciones" widget="custom_monetary_float"/>
                <field name="neto" widget="monetary"/>
            </list>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="nomina_search_view" model="ir.ui.view">
        <field name="name">nomina.search.view</field>
        <field name="model">nomina.nomina</field>
        <field name="arch" type="xml">
            <search>
                <filter
                    string="Archivados"
                    name="archived"
                    domain="[('active','!=',True)]"
                />
            </search>
        </field>
    </record>

    <!-- ACCIÓN -->
    <record id="nomina_action" model="ir.actions.act_window">
        <field name="name">Nómina Historial</field>
        <field name="res_model">nomina.nomina</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="nomina_search_view"/>
    </record>

</odoo>