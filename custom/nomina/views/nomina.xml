<odoo>

    <!-- FORM VIEW -->
    <record id="nomina_form_view" model="ir.ui.view">
        <field name="name">nomina.form.view</field>
        <field name="model">nomina.nomina</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_calcular_isr" string="Calcular ISR" type="object" class="btn-primary"/>
                    <button name="action_calcular_imss" string="Calcular IMSS" type="object" class="btn-primary"/>
                    <field name="estado" widget="statusbar" clickable="True"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" class="h1 text-muted"/>
                            <field name="empleado_id"/>
                            <field name="fecha_inicio"/>
                            <field name="fecha_fin"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="total_percepciones" widget="custom_monetary_float"/>
                            <field name="total_deducciones" widget="custom_monetary_float"/>
                            <field name="neto" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Percepciones">
                            <field name="percepcion_ids">
                                <list>
                                    <field name="concepto_id"/>
                                    <field name="cantidad"/>
                                    <field name="importe"/>
                                    <field name="importe_gravado"/>
                                    <field name="importe_exento"/>
                                    <field name="total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Deducciones">
                            <field name="deduccion_ids">
                                <list>
                                    <field name="tipo"/>
                                    <field name="concepto"/>
                                    <field name="importe"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="nomina_list_view" model="ir.ui.view">
        <field name="name">nomina.list.view</field>
        <field name="model">nomina.nomina</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="empleado_id"/>
                <field name="fecha_inicio"/>
                <field name="fecha_fin"/>
                <field name="estado"/>
                <field name="active" widget="boolean_toggle"/>
                <field name="total_percepciones" widget="custom_monetary_float"/>
                <field name="total_deducciones" widget="custom_monetary_float"/>
                <field name="neto" widget="monetary"/>
            </list>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="nomina_search_view" model="ir.ui.view">
        <field name="name">nomina.search.view</field>
        <field name="model">nomina.nomina</field>
        <field name="arch" type="xml">
            <search>
                <filter
                    string="Archivados"
                    name="archived"
                    domain="[('active','!=',True)]"
                />
            </search>
        </field>
    </record>

    <!-- ACCIÓN -->
    <record id="nomina_action" model="ir.actions.act_window">
        <field name="name">Nómina Historial</field>
        <field name="res_model">nomina.nomina</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="nomina_search_view"/>
    </record>

</odoo>