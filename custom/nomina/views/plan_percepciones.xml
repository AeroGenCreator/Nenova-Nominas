<odoo>
    
    <!-- FORM VIEW -->
    <record id="plan_percepciones_form_view" model="ir.ui.view">
        <field name="name">plan.percepciones.form.view</field>
        <field name="model">nomina.plan.percepciones</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        string="Agregar Empleados (Manual)"
                        type="action"
                        name="%(nomina_plan_percepciones_empleado_wizard)d"
                        class="btn-success"
                        icon="fa-user-plus"
                    />
                </header>
                <sheet>
                    <group>
                        <field name="name" class="fw-bold"/>
                        <field name="active" widget="boolean_toggle"/>      
                    </group>
                    <notebook>
                        <page string="Percepciones">
                            <field name="percepciones_ids"/>
                        </page>
                        <page string="Empleados">
                            <field name="empleado_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->

    <!-- SEARCH VIEW -->

    <!-- ACCIÓN -->
    <record id="plan_percepciones_action" model="ir.actions.act_window">
        <field name="name">Planes - Percepciones</field>
        <field name="res_model">nomina.plan.percepciones</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>