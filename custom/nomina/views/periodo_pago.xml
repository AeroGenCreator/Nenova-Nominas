<odoo>
    
    <!-- VISTA FORMULARIO -->
    <record id="nomina_periodo_pago_form_view" model="ir.ui.view">
        <field name="name">nomina.periodo.pago.form.view</field>
        <field name="model">nomina.periodo.pago</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Configuración">
                        <group>
                            <field name="name"/>
                            <field name="clave"/>
                        </group>
                        <group>
                            <field name="dias" widget="char"/>
                            <field name="dias_imss" widget="char"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- VISTA LISTA -->
    <record id="nomina_periodo_pago_list_view" model="ir.ui.view">
        <field name="name">nomina.periodo.pago.list.view</field>
        <field name="model">nomina.periodo.pago</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" width="100"/>
                <field name="clave" width="60"/>
                <field name="dias" width="60" widget="char"/>
                <field name="dias_imss" width="60" widget="char"/>
                <field name="active" width="60"/>
            </list>
        </field>
    </record>

    <!-- VISTA SEARCH -->
    <record id="nomina_periodo_pago_search_view" model="ir.ui.view">
        <field name="name">nomina.periodo.pago.search.view</field>
        <field name="model">nomina.periodo.pago</field>
        <field name="arch" type="xml">
            <search>
                <filter
                    string="Archivados"
                    name="archived"
                    domain="[('active','!=',True)]"
                />
            </search>
        </field>
    </record>

    <!-- ACCION DE VISTA S-->
    <record id="periodo_pago_action" model="ir.actions.act_window">
        <field name="name">Periodo Pagos</field>
        <field name="res_model">nomina.periodo.pago</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="nomina_periodo_pago_search_view"/>
    </record>

</odoo>
