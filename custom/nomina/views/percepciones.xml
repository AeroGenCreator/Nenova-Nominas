<odoo>
    
    <!-- FORM VIEW -->
    <record id="nomina_percepcion_form_view" model="ir.ui.view">
        <field name="name">nomina.percepcion.form.view</field>
        <field name="model">nomina.percepciones</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" class="fw-bold"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="nomina_percepcion_list_view" model="ir.ui.view">
        <field name="name">nomina.percepcion.list.view</field>
        <field name="model">nomina.percepciones</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" class="fw-bold"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="nomina_percepcion_search_view" model="ir.ui.view">
        <field name="name">nomina.percepcion.search.view</field>
        <field name="model">nomina.percepciones</field>
        <field name="arch" type="xml">
            <search>
                <filter
                    string="Archivados"
                    name="archived"
                    domain="[('active','!=',True)]"
                />
            </search>
        </field>
    </record>

    <!-- ACCIÓN -->
    <record id="percepcion_action" model="ir.actions.act_window">
        <field name="name">Percepciones</field>
        <field name="res_model">nomina.percepciones</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="nomina_percepcion_search_view"/>
    </record>

</odoo>