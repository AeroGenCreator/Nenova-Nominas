<odoo>
    
    <!-- FORM VIEW -->
    <record id="nomina_percepcion_form_view" model="ir.ui.view">
        <field name="name">nomina.percepcion.form.view</field>
        <field name="model">nomina.percepciones</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="tipo_de_calculo" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <group string="Percepciones">
                        <group string="Configuración">
                            <field name="name"/>
                            <field name="periodicidad"/>
                            <field
                                name="monto"
                                widget="custom_monetary_float"
                                invisible="tipo_de_calculo in ['formula', 'variable']"
                            />
                            <field
                                name="condicion"
                                invisible="tipo_de_calculo not in ['formula', 'variable']"
                            />
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Parametros">
                            <field name="integra_sdi" widget="boolean_toggle"/>
                            <field name="grava_isr" widget="boolean_toggle"/>
                            <field name="grava_imss" widget="boolean_toggle"/>
                            <field name="grava_isn" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- LIST VIEW -->
    <record id="nomina_percepcion_list_view" model="ir.ui.view">
        <field name="name">nomina.percepcion.list.view</field>
        <field name="model">nomina.percepciones</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="nomina_percepcion_search_view" model="ir.ui.view">
        <field name="name">nomina.percepcion.search.view</field>
        <field name="model">nomina.percepciones</field>
        <field name="arch" type="xml">
            <search>
                <filter
                    string="Archivados"
                    name="archived"
                    domain="[('active','!=',True)]"
                />
            </search>
        </field>
    </record>

    <!-- ACCIÓN -->
    <record id="percepcion_action" model="ir.actions.act_window">
        <field name="name">Percepciones</field>
        <field name="res_model">nomina.percepciones</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="nomina_percepcion_search_view"/>
    </record>

</odoo>