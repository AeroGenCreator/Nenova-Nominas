<odoo>
    
    <!-- VISTA FORMULARIO -->
    <record id="nomina_vacacional_categoria_form_view" model="ir.ui.view">
        <field name="name">nomina.vacacional.categoria.form.view</field>
        <field name="model">nomina.vacacional.categoria</field>
        <field name="arch" type="xml">
            <form>
                <group string="Configuración">
                    <field name="name"/>
                    <field name="active" widget="boolean_toggle"/>
                </group>
            </form>
        </field>
    </record>

    <!-- VISTA LISTA -->
    <record id="nomina_vacacional_categoria_list_view" model="ir.ui.view">
        <field name="name">nomina.vacacional.categoria.list.view</field>
        <field name="model">nomina.vacacional.categoria</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- VISTA SEARCH -->
    <record id="nomina_vacacional_categoria_search_view" model="ir.ui.view">
        <field name="name">nomina.vacacional.categoria.search.view</field>
        <field name="model">nomina.vacacional.categoria</field>
        <field name="arch" type="xml">
            <search>
                <filter
                    string="Archivados"
                    name="archived"
                    domain="[('active','!=',True)]"
                />
            </search>
        </field>
    </record>

    <!-- ACCIÓN -->
    <record id="nomina_vacacional_categoria_action" model="ir.actions.act_window">
        <field name="name">Vacacional Categoria</field>
        <field name="res_model">nomina.vacacional.categoria</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="nomina_vacacional_categoria_search_view"/>
    </record>

</odoo>