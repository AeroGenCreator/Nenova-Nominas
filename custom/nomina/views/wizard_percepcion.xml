<odoo>

	<record id="percepcion_wizard_form_view" model="ir.ui.view">
		<field name="name">percepcion.wizard.form.view</field>
		<field name="model">percepcion.wizard</field>
		<field name="arch" type="xml">
			<form>
				<sheet>
					<group string="Percepción">
						<group string="Configuración">
							<field name="name"/>
							<field name="nomina_id"/>
							<field name="concepto_id"/>
							<field name="empleado_id"/>
						</group>
						<group string="Cantidades">
							<field name="cantidad"/>
							<field name="importe"/>
							<field name="total"/>
						</group>
					</group>
				</sheet>
			</form>
		</field>
	</record>

</odoo>