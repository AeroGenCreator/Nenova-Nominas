<odoo>
    
    <!-- SEARCH VIEW -->
    <record id="percepcion_historial_search_view" model="ir.ui.view">
        <field name="name">percepcion.historial.search.view</field>
        <field name="model">nomina.percepcion.historial</field>
        <field name="arch" type="xml">
            <search>
                <filter
                    string="Archivados"
                    name="archived"
                    domain="[('active','!=',True)]"
                />
            </search>
        </field>
    </record>

    <!-- ACCIÓN -->
    <record id="percepcion_historial_action" model="ir.actions.act_window">
        <field name="name">Percepción Historial</field>
        <field name="res_model">nomina.percepcion.historial</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="percepcion_historial_search_view"/>
    </record>

</odoo>