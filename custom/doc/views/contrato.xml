<odoo>

    <record id="contrato_form_view" model="ir.ui.view">
        <field name="name">contrato.form.view</field>
        <field name="model">contrato</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group string="Información Requerida">
                        <field name="name" />
                        <field name="empleado_id" />
                        <field name="comienza" />
                        <field name="finaliza" />
                        <field name="vigencia" />
                    </group>
                    <group string="Contrato">
                        <field name="active" widget="toggle" />
                        <field name="contrato_pdf" widget="pdf_viewer" />
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id="contrato_list_view" model="ir.ui.view">
        <field name="name">contrato.list.view</field>
        <field name="model">contrato</field>
        <field name="arch" type="xml">
            <list
                string="Lista Contratos"
                decoration-success="vigencia &gt; 30"
                decoration-warning="vigencia &gt; 0 and vigencia &lt; 30"
                decoration-danger="vigencia == 0"
                decoration-muted="active == False"
            >
                <field name="name" />
                <field name="active" />
            </list>
        </field>
    </record>

    <record id="contrato_search_view" model="ir.ui.view">
        <field name="name">contrato.search.view</field>
        <field name="model">contrato</field>
        <field name="arch" type="xml">
            <search>
                <filter
                    string="Activos"
                    name="activos"
                    domain="[('active','=', True)]"
                />
            </search>
        </field>
    </record>

    <record id="contrato_view_action" model="ir.actions.act_window">
        <field name="name">Contratos</field>
        <field name="res_model">contrato</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="contrato_search_view" />
    </record>

</odoo>
