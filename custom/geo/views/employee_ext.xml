<odoo>

    <record id="geo_employee_ext" model="ir.ui.view">
        <field name="name">geo.employee.ext</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Ubicaciones">
                    <field name="plan_ids" />
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_agregar_ubicacion_multi" model="ir.actions.server">
        <field name="name">Agregar Ubicaciones Empresa (Masivo)</field>
        <field name="model_id" ref="hr.model_hr_employee" />
        <field name="binding_model_id" ref="hr.model_hr_employee" />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_agregar_ubicacion()
        </field>
    </record>

</odoo>
