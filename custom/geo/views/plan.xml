<odoo>

    <!-- VISTA FORMULARIO -->
    <record id="geo_plan_from_view" model="ir.ui.view">
        <field name="name">geo.plan.form.view</field>
        <field name="model">geo.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group string="Formulario">
                        <field name="name" />
                        <field name="active" widget="boolean_toggle" />
                    </group>
                    <notebook>
                        <page string="Localizaciones">
                            <field name="plan_ubicacion_ids" />
                        </page>
                        <page string="Empleados">
                            <field name="empleado_ids">
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="name" />
                                                <field name="empleado_id" />
                                            </group>
                                            <group>
                                                <field name="plan_id" />
                                                <field
                                                    name="active"
                                                    widget="boolean_toggle"
                                                />
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- VISTA LISTA -->
    <record id="geo_plan_list_view" model="ir.ui.view">
        <field name="name">geo.plan.list.view</field>
        <field name="model">geo.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="active" />
            </list>
        </field>
    </record>

    <!-- BARRA DE BUSQUEDA -->
    <record id="geo_plan_search_view" model="ir.ui.view">
        <field name="name">geo.plan.search.view</field>
        <field name="model">geo.plan</field>
        <field name="arch" type="xml">
            <search>
                <filter
                    string="Archivados"
                    name="planes_archivados"
                    domain="[('active', '!=', True)]"
                />
            </search>
        </field>
    </record>

    <!-- ACCION DE LA VISTA -->
    <record id="plan_view_action" model="ir.actions.act_window">
        <field name="name">Planes</field>
        <field name="res_model">geo.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="geo_plan_search_view" />
    </record>

</odoo>
